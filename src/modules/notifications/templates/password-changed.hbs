{{!-- What to do if the customer did not make the change themselves. --}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:28px 0 0;">
  <tr>
    <td style="padding:16px 20px; background-color:#FBF8F3; border-left:3px solid #C9A55C; border-radius:0 10px 10px 0; font-family:-apple-system, 'Segoe UI', Helvetica, Arial, sans-serif; font-size:14px; line-height:22px; color:#2B2226;">
      {{copy.notYou}} <a href="mailto:{{supportEmail}}" style="color:#4A1942; font-weight:600; text-decoration:underline;">{{supportEmail}}</a>
    </td>
  </tr>
</table>
