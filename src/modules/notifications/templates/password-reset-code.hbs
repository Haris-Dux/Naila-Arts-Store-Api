{{!-- The one-time code, large and spaced out so it is easy to read and type. --}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:28px 0 0;">
  <tr>
    <td align="center" style="padding:28px 16px 24px; background-color:#FBF8F3; border:1px solid #C9A55C; border-radius:14px;">
      <div style="font-family:-apple-system, 'Segoe UI', Helvetica, Arial, sans-serif; font-size:11px; line-height:16px; font-weight:600; letter-spacing:2px; text-transform:uppercase; color:#6F6468;">{{copy.codeLabel}}</div>
      <div style="margin-top:12px; padding-left:10px; font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:34px; line-height:42px; font-weight:bold; letter-spacing:10px; color:#4A1942;">{{code}}</div>
      <div style="margin-top:12px; font-family:-apple-system, 'Segoe UI', Helvetica, Arial, sans-serif; font-size:13px; line-height:20px; color:#6F6468;">{{copy.expiry}}</div>
    </td>
  </tr>
</table>

<p style="margin:24px 0 0; font-family:-apple-system, 'Segoe UI', Helvetica, Arial, sans-serif; font-size:14px; line-height:22px; color:#6F6468;">{{copy.ignore}}</p>
